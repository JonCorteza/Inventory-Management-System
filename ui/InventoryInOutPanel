    return scrollPane;
}

    private void loadProducts() {

        // Remember what was selected so the filter doesn't reset
        // every time the combo box gets rebuilt (e.g. after an
        // Incoming/Outgoing action or a manual Refresh).
        Product previouslySelected =
                (Product) productComboBox.getSelectedItem();

        productComboBox.removeAllItems();

        List<Product> products =
                productDAO.getProducts(1, 10000, null);

        for (Product product : products) {
            productComboBox.addItem(product);
        }

        if (previouslySelected != null) {
            for (int i = 0; i < productComboBox.getItemCount(); i++) {

                Product product = productComboBox.getItemAt(i);

                if (product.getIdno() == previouslySelected.getIdno()) {
                    productComboBox.setSelectedIndex(i);
                    break;
                }
            }
        }
    }

    private void loadMovements() {

        tableModel.setRowCount(0);

        Product selectedProduct =
                (Product) productComboBox.getSelectedItem();

        // No product selected (e.g. product list is empty) -> nothing to show.
        if (selectedProduct == null) {
            return;
        }

        List<InventoryInOut> movements =
                inventoryDAO.getAllMovements();

        for (InventoryInOut movement : movements) {

            // Only keep movements (both INCOMING and OUTGOING) that
            // belong to the product currently selected above.
            //
            // NOTE: matched here by product name, since that's the
            // field exposed on InventoryInOut. If your InventoryInOut
            // model has (or you add) a getProductId(), prefer comparing
            // that against selectedProduct.getIdno() instead - it's a
            // safer match if two products can ever share the same name.
            if (!selectedProduct.getName().equals(movement.getProductName())) {
                continue;
            }

            String formattedDate = "";

            if (movement.getTransactionDate() != null) {
                formattedDate =
                        dateFormat.format(movement.getTransactionDate());
            }

            tableModel.addRow(new Object[]{
                    movement.getInventoryId(),
                    movement.getProductName(),
                    movement.getMovementType(),
                    Math.abs(movement.getQuantity()),
                    formattedDate
            });
        }
    }

    private void processIncoming() {

        Product selectedProduct =
                (Product) productComboBox.getSelectedItem();

        if (selectedProduct == null) {
            JOptionPane.showMessageDialog(
                    this,
                    "Please select a product.",
                    "Inventory",
                    JOptionPane.WARNING_MESSAGE
            );
            return;
        }

        int quantity = getQuantity();

        if (quantity <= 0) {
            return;
        }

        boolean success = inventoryDAO.recordMovement(
                selectedProduct.getIdno(),
                quantity
        );

        if (success) {

            loadProducts();
            loadMovements();
            updateCurrentStock();

            quantityField.setText("");

            JOptionPane.showMessageDialog(
                    this,
                    "Incoming stock recorded successfully."
            );

        } else {

            JOptionPane.showMessageDialog(
                    this,
                    "Unable to record incoming stock.",
                    "Inventory",
                    JOptionPane.ERROR_MESSAGE
            );
        }
    }

    private void processOutgoing() {

        Product selectedProduct =
                (Product) productComboBox.getSelectedItem();

        if (selectedProduct == null) {
            JOptionPane.showMessageDialog(
                    this,
                    "Please select a product.",
                    "Inventory",
                    JOptionPane.WARNING_MESSAGE
            );
            return;
        }

        int quantity = getQuantity();

        if (quantity <= 0) {
            return;
        }

        boolean success = inventoryDAO.recordMovement(
                selectedProduct.getIdno(),
                -quantity
        );

        if (success) {

            loadProducts();
            loadMovements();
            updateCurrentStock();

            quantityField.setText("");

            JOptionPane.showMessageDialog(
                    this,
                    "Outgoing stock recorded successfully."
            );

        } else {

            JOptionPane.showMessageDialog(
                    this,
                    "Unable to record outgoing stock.\n"
                    + "Make sure there is enough stock.",
                    "Inventory",
                    JOptionPane.WARNING_MESSAGE
            );
        }
    }

private int getQuantity() {

    String text = quantityField.getText().trim();

    if (text.isEmpty()) {

        JOptionPane.showMessageDialog(
                this,
                "Quantity is invalid.\nPlease enter a quantity.",
                "Invalid Quantity",
                JOptionPane.WARNING_MESSAGE
        );

        return -1;
    }

    try {

        int quantity = Integer.parseInt(text);

        if (quantity <= 0) {

            JOptionPane.showMessageDialog(
                    this,
                    "Quantity is invalid.\nPlease enter a number greater than zero.",
                    "Invalid Quantity",
                    JOptionPane.WARNING_MESSAGE
            );

            return -1;
        }

        return quantity;

    } catch (NumberFormatException e) {

        JOptionPane.showMessageDialog(
                this,
                "Quantity is invalid.\nPlease enter a whole number.",
                "Invalid Quantity",
                JOptionPane.WARNING_MESSAGE
        );

        return -1;
    }
}
}
