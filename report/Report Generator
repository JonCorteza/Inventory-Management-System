package inventorymanagementsystem.report;

import inventorymanagementsystem.dao.InventoryDAO;
import inventorymanagementsystem.dao.InventoryInOutDAO;
import inventorymanagementsystem.dao.ProductDAO;
import inventorymanagementsystem.dao.SupplierDAO;
import inventorymanagementsystem.model.InventoryInOut;
import inventorymanagementsystem.model.Product;
import inventorymanagementsystem.model.Supplier;

import java.io.IOException;
import java.math.BigDecimal;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.text.DecimalFormat;
import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

import org.apache.pdfbox.pdmodel.PDDocument;
import org.apache.pdfbox.pdmodel.PDPage;
import org.apache.pdfbox.pdmodel.PDPageContentStream;
import org.apache.pdfbox.pdmodel.common.PDRectangle;
import org.apache.pdfbox.pdmodel.font.PDType1Font;
import org.apache.pdfbox.pdmodel.font.Standard14Fonts;

public class ReportGenerator {

    private final ProductDAO productDAO = new ProductDAO();
    private final InventoryDAO inventoryDAO = new InventoryDAO();
    private final InventoryInOutDAO inventoryInOutDAO = new InventoryInOutDAO();
    private final SupplierDAO supplierDAO = new SupplierDAO();

    private final DecimalFormat numberFormat = new DecimalFormat("#,##0.00");
    private final SimpleDateFormat fileDate = new SimpleDateFormat("yyyy-MM-dd_HHmmss");
    private final SimpleDateFormat displayDate = new SimpleDateFormat("MMMM dd, yyyy hh:mm a");

    private static final int ROWS_PER_PAGE = 25;

    public Path generateReport() throws IOException {
        Path directory = Paths.get("reports");
        Files.createDirectories(directory);

        Path output = directory.resolve("inventory_report_" + fileDate.format(new Date()) + ".pdf");

        List<Product> products = productDAO.getProducts(1, 10000, null);
        List<Supplier> suppliers = supplierDAO.getAll();
        List<InventoryInOut> movements = inventoryInOutDAO.getAllMovements();

        BigDecimal inventoryValue = productDAO.getTotalInventoryValue();
        double stockHealth = productDAO.getStockHealthPercentage(20);
        int unitsSold = inventoryDAO.getTotalUnitsSold();

        int incomingUnits = 0;
        int outgoingUnits = 0;

        for (InventoryInOut movement : movements) {
            int quantity = movement.getQuantity();

            if (quantity > 0) {
                incomingUnits += quantity;
            } else if (quantity < 0) {
                outgoingUnits += Math.abs(quantity);
            }
        }

        try (PDDocument document = new PDDocument()) {
            createProductPages(document, products, suppliers, inventoryValue, stockHealth,
                    unitsSold, incomingUnits, outgoingUnits);
            createSupplierPages(document, suppliers);
            document.save(output.toFile());
        }

        return output;
    }

    // PRODUCT PAGES

    private void createProductPages(PDDocument document, List<Product> products, List<Supplier> suppliers,
                                    BigDecimal inventoryValue, double stockHealth, int unitsSold,
                                    int incomingUnits, int outgoingUnits) throws IOException {

        Map<Integer, String> supplierNames = new HashMap<>();

        for (Supplier supplier : suppliers) {
            supplierNames.put(supplier.getSupplierId(), supplier.getSupplierName());
        }

        int index = 0;
        boolean firstPage = true;

        while (index < products.size() || firstPage) {
            PDPage page = new PDPage(PDRectangle.A4);
            document.addPage(page);

            try (PDPageContentStream content = new PDPageContentStream(document, page)) {
                float y = 780;

                if (firstPage) {
                    y = writeSummary(content, y, products.size(), suppliers.size(), inventoryValue,
                            stockHealth, unitsSold, incomingUnits, outgoingUnits);
                }

                y = writeProductHeader(content, y);

                int count = 0;

                while (index < products.size() && count++ < ROWS_PER_PAGE) {
                    writeProductRow(content, products.get(index++), supplierNames, y);
                    y -= 18;
                }
            }

            firstPage = false;
        }
    }

    // SUMMARY

    private float writeSummary(PDPageContentStream content, float y, int productCount, int supplierCount,
                               BigDecimal inventoryValue, double stockHealth, int unitsSold,
                               int incomingUnits, int outgoingUnits) throws IOException {

        writeText(content, "INVENTORY MANAGEMENT SYSTEM", 50, y, 20, true);
        y -= 30;

        writeText(content, "DETAILED INVENTORY REPORT", 50, y, 14, true);
        y -= 25;

        writeText(content, "Generated: " + displayDate.format(new Date()), 50, y, 9, false);
        y -= 35;

        writeSectionTitle(content, "SUMMARY", 50, y);
        y -= 22;

        writeText(content, "Total Products: " + productCount, 55, y, 10, false);
        y -= 17;

        writeText(content, "Total Suppliers: " + supplierCount, 55, y, 10, false);
        y -= 17;

        writeText(content, "Inventory Value: PHP " + numberFormat.format(inventoryValue), 55, y, 10, false);
        y -= 17;

        writeText(content, "Stock Health: " + numberFormat.format(stockHealth) + "%", 55, y, 10, false);
        y -= 17;

        writeText(content, "Total Units Sold: " + unitsSold, 55, y, 10, false);
        y -= 17;

        writeText(content, "Total Incoming Units: " + incomingUnits, 55, y, 10, false);
        y -= 17;

        writeText(content, "Total Outgoing Units: " + outgoingUnits, 55, y, 10, false);

        return y - 35;
    }

    // PRODUCT TABLE

    private float writeProductHeader(PDPageContentStream content, float y) throws IOException {
        writeSectionTitle(content, "PRODUCT INVENTORY", 40, y);
        y -= 22;

        String[] headers = {"ID", "Product", "Category", "Brand", "Supplier", "Price", "Stock"};
        float[] x = {40, 63, 145, 225, 305, 425, 490};

        for (int i = 0; i < headers.length; i++) {
            writeText(content, headers[i], x[i], y, 8, true);
        }

        y -= 8;
        drawLine(content, 40, y, 550, y);

        return y - 17;
    }

    private void writeProductRow(PDPageContentStream content, Product product,
                                 Map<Integer, String> supplierNames, float y) throws IOException {

        Integer supplierId = product.getSupplierId();
        String supplierName = "-";

        if (supplierId != null) {
            supplierName = supplierNames.get(supplierId);
            if (supplierName == null) {
                supplierName = "-";
            }
        }

        String[] values = {
            String.valueOf(product.getIdno()),
            truncate(product.getName(), 16),
            truncate(product.getCategory(), 11),
            truncate(product.getBrand(), 11),
            truncate(supplierName, 17),
            product.getPrice() == null ? "0.00" : numberFormat.format(product.getPrice()),
            String.valueOf(product.getStock())
        };

        float[] x = {40, 63, 145, 225, 305, 425, 490};

        for (int i = 0; i < values.length; i++) {
            writeText(content, values[i], x[i], y, 7, false);
        }
    }

    // SUPPLIER PAGES

    private void createSupplierPages(PDDocument document, List<Supplier> suppliers) throws IOException {
        if (suppliers.isEmpty()) {
            createEmptyPage(document, "SUPPLIER DIRECTORY", "No suppliers found.");
            return;
        }

        for (int start = 0; start < suppliers.size(); start += ROWS_PER_PAGE) {
            PDPage page = new PDPage(PDRectangle.A4);
            document.addPage(page);

            try (PDPageContentStream content = new PDPageContentStream(document, page)) {
                float y = 780;

                writeText(content, "SUPPLIER DIRECTORY", 40, y, 16, true);
                y -= 30;

                String[] headers = {"ID", "Supplier", "Contact Person", "Phone", "Address"};
                float[] x = {40, 70, 200, 340, 420};

                for (int i = 0; i < headers.length; i++) {
                    writeText(content, headers[i], x[i], y, 8, true);
                }

                y -= 8;
                drawLine(content, 40, y, 550, y);
                y -= 17;

                int end = Math.min(start + ROWS_PER_PAGE, suppliers.size());

                for (int i = start; i < end; i++) {
                    writeSupplierRow(content, suppliers.get(i), y);
                    y -= 18;
                }
            }
        }
    }

    private void writeSupplierRow(PDPageContentStream content, Supplier supplier, float y) throws IOException {
        String[] values = {
            String.valueOf(supplier.getSupplierId()),
            truncate(supplier.getSupplierName(), 20),
            truncate(supplier.getContactPerson(), 20),
            truncate(supplier.getPhone(), 14),
            truncate(supplier.getAddress(), 20)
        };

        float[] x = {40, 70, 200, 340, 420};

        for (int i = 0; i < values.length; i++) {
            writeText(content, values[i], x[i], y, 7, false);
        }
    }

    // PDF UTILITIES

    private void createEmptyPage(PDDocument document, String title, String message) throws IOException {
        PDPage page = new PDPage(PDRectangle.A4);
        document.addPage(page);

        try (PDPageContentStream content = new PDPageContentStream(document, page)) {
            writeText(content, title, 50, 780, 16, true);
            writeText(content, message, 50, 750, 10, false);
        }
    }

    private void writeSectionTitle(PDPageContentStream content, String text, float x, float y) throws IOException {
        writeText(content, text, x, y, 11, true);
        drawLine(content, x, y - 5, 550, y - 5);
    }

    private void writeText(PDPageContentStream content, String text, float x, float y,
                           float size, boolean bold) throws IOException {

        PDType1Font font = new PDType1Font(
                bold ? Standard14Fonts.FontName.HELVETICA_BOLD : Standard14Fonts.FontName.HELVETICA
        );

        content.beginText();
        content.setFont(font, size);
        content.newLineAtOffset(x, y);
        content.showText(safe(text));
        content.endText();
    }

    private void drawLine(PDPageContentStream content, float x1, float y1, float x2, float y2) throws IOException {
        content.moveTo(x1, y1);
        content.lineTo(x2, y2);
        content.stroke();
    }

    private String truncate(String text, int maxLength) {
        if (text == null) return "-";
        if (text.length() <= maxLength) return text;
        return text.substring(0, maxLength - 3) + "...";
    }

    private String safe(String text) {
        if (text == null) return "-";

        return text
                .replace("\u20B1", "PHP")
                .replace("\u2013", "-")
                .replace("\u2014", "-");
    }
}
