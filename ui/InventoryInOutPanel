    movementTable.setGridColor(new Color(0x22, 0x22, 0x22));
    movementTable.setSelectionBackground(UITheme.BG_TABLE_ALT);
    movementTable.setSelectionForeground(UITheme.TEXT_PRIMARY);
    movementTable.setShowVerticalLines(false);
    movementTable.setFillsViewportHeight(true);

    // Match the system table header
    JTableHeader header = movementTable.getTableHeader();
    header.setBackground(UITheme.BG_PANEL);
    header.setForeground(UITheme.ACCENT_GREEN);
    header.setFont(UITheme.FONT_BOLD);
