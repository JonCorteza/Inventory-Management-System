public class InventoryInOutPanel extends JPanel {

    private final ProductDAO productDAO = new ProductDAO();
    private final InventoryInOutDAO inventoryDAO = new InventoryInOutDAO();
    private final SimpleDateFormat dateFormat = new SimpleDateFormat("MMM dd, yyyy h:mm a");

    private JComboBox<Product> productComboBox;
    private JTextField quantityField;
    private JTable movementTable;
    private DefaultTableModel tableModel;
    private JLabel currentStockLabel;

    public InventoryInOutPanel() {

        setLayout(new BorderLayout(0, 16));
        setOpaque(false);
        setBorder(new EmptyBorder(10, 10, 10, 10));

        add(buildHeader(), BorderLayout.NORTH);
        add(buildCenter(), BorderLayout.CENTER);

        loadProducts();
        loadMovements();
    }

    private JPanel buildHeader() {

        JPanel header = new JPanel(new BorderLayout());
        header.setOpaque(false);

        JLabel title = new JLabel("Inventory In / Out");
        title.setForeground(UITheme.TEXT_PRIMARY);
        title.setFont(UITheme.FONT_TITLE.deriveFont(20f));

        JLabel subtitle = new JLabel(
                "Monitor incoming and outgoing stock movements"
        );
        subtitle.setForeground(UITheme.TEXT_MUTED);
        subtitle.setFont(UITheme.FONT_BODY);

        JPanel titlePanel = new JPanel();
        titlePanel.setOpaque(false);
        titlePanel.setLayout(new BoxLayout(titlePanel, BoxLayout.Y_AXIS));

        titlePanel.add(title);
        titlePanel.add(Box.createVerticalStrut(4));
        titlePanel.add(subtitle);

        header.add(titlePanel, BorderLayout.WEST);

        return header;
    }

    private JPanel buildCenter() {

        JPanel center = new JPanel(new BorderLayout(0, 15));
        center.setOpaque(false);

        center.add(buildMovementForm(), BorderLayout.NORTH);
        center.add(buildMovementTable(), BorderLayout.CENTER);

        return center;
    }

    private JPanel buildMovementForm() {

    JPanel form = new JPanel(new BorderLayout(12, 0));
    form.setBackground(UITheme.BG_PANEL);
    form.setBorder(UITheme.cardBorder());

    // Left side: Product and Current Stock
    JPanel leftFields = new JPanel(new FlowLayout(
            FlowLayout.LEFT, 7, 10
    ));
    leftFields.setOpaque(false);

    JLabel productLabel = new JLabel("Product:");
    productLabel.setForeground(UITheme.TEXT_MUTED);
    productLabel.setFont(UITheme.FONT_BODY);

    productComboBox = new JComboBox<>();
    productComboBox.setFont(UITheme.FONT_BODY);
    productComboBox.setBackground(UITheme.BG_PANEL);
    productComboBox.setForeground(UITheme.TEXT_PRIMARY);
    productComboBox.setPreferredSize(new Dimension(220, 35));
    productComboBox.addActionListener(e -> {
        updateCurrentStock();
        loadMovements();
    });

    JLabel stockLabel = new JLabel("Current Stock:");
    stockLabel.setForeground(UITheme.TEXT_MUTED);
    stockLabel.setFont(UITheme.FONT_BODY);

    currentStockLabel = new JLabel("0");
    currentStockLabel.setForeground(UITheme.TEXT_PRIMARY);
    currentStockLabel.setFont(UITheme.FONT_BODY);
    currentStockLabel.setPreferredSize(new Dimension(70, 35));

    leftFields.add(productLabel);
    leftFields.add(productComboBox);
    leftFields.add(stockLabel);
    leftFields.add(currentStockLabel);

    // Center: Quantity
    JPanel quantityPanel = new JPanel(new BorderLayout(7, 0));
    quantityPanel.setOpaque(false);
    quantityPanel.setBorder(new EmptyBorder(10, 0, 10, 0));

    JLabel quantityLabel = new JLabel("Quantity:");
    quantityLabel.setForeground(UITheme.TEXT_MUTED);
    quantityLabel.setFont(UITheme.FONT_BODY);

    quantityField = new JTextField();
    UITheme.styleTextField(quantityField);

    quantityPanel.add(quantityLabel, BorderLayout.WEST);
    quantityPanel.add(quantityField, BorderLayout.CENTER);

    // Right side: Action buttons
    JPanel actions = new JPanel(new FlowLayout(
            FlowLayout.RIGHT, 7, 10
    ));
    actions.setOpaque(false);

    JButton incomingButton = new JButton("INCOMING");
    UITheme.stylePrimaryButton(incomingButton);
    incomingButton.setPreferredSize(new Dimension(105, 35));
    incomingButton.addActionListener(e -> processIncoming());

    JButton outgoingButton = new JButton("OUTGOING");
    UITheme.styleDangerButton(outgoingButton);
    outgoingButton.setPreferredSize(new Dimension(105, 35));
    outgoingButton.addActionListener(e -> processOutgoing());

    JButton refreshButton = new JButton("REFRESH");
    UITheme.styleSecondaryButton(refreshButton);
    refreshButton.setPreferredSize(new Dimension(105, 35));
    refreshButton.addActionListener(e -> {
        loadProducts();
        loadMovements();
    });

    actions.add(incomingButton);
    actions.add(outgoingButton);
    actions.add(refreshButton);

    form.add(leftFields, BorderLayout.WEST);
    form.add(quantityPanel, BorderLayout.CENTER);
    form.add(actions, BorderLayout.EAST);

    return form;
}
    
    private void updateCurrentStock() {

    Product selectedProduct =
            (Product) productComboBox.getSelectedItem();

    if (selectedProduct == null) {
        currentStockLabel.setText("0");
        return;
    }

    currentStockLabel.setText(
            String.valueOf(selectedProduct.getStock())
    );
}

